###
# group: Search User
# @name Search
# this request should just send "username" or "mobile".
# if both entered, mobile is more priority.
GET {{base_url}}/api/v1/search-user/search
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json

{
    "username": "",
    "mobile": "09365371302"
}

###
# group: Message
# @name send
# if id_message_hook is entered, it will be validated \[true or false\].
# id_message_hook be null, id_user will validated.
# context limit character: 500
# if message type is attachment \[2\] id_attachment is required and context could be null.
POST {{base_url}}/api/v1/message/send
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json

{
    "id_message_hook": 20,
    "id_user": 2,
    "context": "this caption",
    "type": 1
}

###
# group: Message
# @name get
# StartFragment
# api/v1/chat/get-messages/20/56
# 20 = id_message_hook \[required\]
# 56 = offset to get messages before this id_message \[optional\]
# EndFragment
GET {{base_url}}/api/v1/message/get/20/56
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json

###
# group: Message
# @name list
GET {{base_url}}/api/v1/message/list
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json

###
