###
# group: Websocket
# @name auth new messages
POST {{base_url}}/api/v1/websocket/auth-new-messages
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json

{
    "socket_id": "699803710.4845780",
    "channel_names": [
        "private-new_messages.id_message_hook.20",
        "private-new_messages.id_message_hook.21",
        "private-new_messages.id_message_hook.22"
    ]
}

###
# group: Websocket
# @name auth for all websockets
POST {{base_url}}/api/broadcasting/auth
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json
#x-app-id: {{app_id}}

{
    "socket_id": "267499057.882048137",
    "channel_name": "private-user.1"
}

###
# group: User / Info
# @name user info
# gender : [
#     man = 1,
#     woman = 0
# ]
PUT {{base_url}}/api/v1/user/info/update
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json

{
    "name": "aleex 30",
    "gender": 0,
    "username": "alitna30"
}


